{
  "id": "can_scanner",
  "title": "Signal Scanner",
  "description": "Logs every change of the car signals it listens to, with a time, to a file. Read only.",
  "version": "0.1.0",
  "vendor": "custom",
  "loggingId": "SCAN",
  "iconGlyph": "SCN",
  "shared": [],
  "signals": {
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineSpeed2": "rs",
      "statusEngineTemperature": "rs"
    },
    "de.bmw.infotainment.vehicle.CDS2": {
      "statusLongitudinalAccelerationMassCenter": "rs",
      "statusLateralAccelerationMassCenter": "rs"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infotainment.drivingexcitement.FES": {
      "statusSwitchDriveDynamicSport2": "rs",
      "statusActualValueTorque2": "rs",
      "statusFESVehicleDynamicSwitchHMI": "rs"
    },
    "de.bmw.infrastructure.VehicleInformation": {
      "statusGearboxDrive": "s",
      "DataPowerTrain2": "s"
    },
    "de.bmw.infotainment.KombiIF": {
      "statusRangeTankStatus": "rs"
    },
    "de.bmw.infrastructure.EnvironmentalInformation": {
      "ExteriorTemperature": "s"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "menu",
      "title": "Signal Scanner",
      "items": [
        [
          "button",
          "BTN_MARK",
          "Mark (then press the button you're testing)"
        ],
        [
          "button",
          "BTN_NEW",
          "New log"
        ],
        [
          "text",
          "STATUS",
          ""
        ],
        [
          "text",
          "FILE",
          ""
        ],
        [
          "text3",
          "MARKED",
          ""
        ],
        [
          "scroll",
          "RECENT",
          ""
        ]
      ]
    }
  ],
  "settings": [],
  "config": {
    "_comment": "watch: what the scanner subscribes to, interface -> fields. Keep it in step with \"signals\" (the installer only grants what \"signals\" lists; the build does not pass \"signals\" to the app).",
    "watch": {
      "de.bmw.infotainment.vehicle.CDS": [
        "statusEngineSpeed2",
        "statusEngineTemperature"
      ],
      "de.bmw.infotainment.vehicle.CDS2": [
        "statusLongitudinalAccelerationMassCenter",
        "statusLateralAccelerationMassCenter"
      ],
      "de.bmw.infotainment.vehicle.Vehicle2": [
        "statusCarSpeed2"
      ],
      "de.bmw.infotainment.drivingexcitement.FES": [
        "statusSwitchDriveDynamicSport2",
        "statusActualValueTorque2",
        "statusFESVehicleDynamicSwitchHMI"
      ],
      "de.bmw.infrastructure.VehicleInformation": [
        "statusGearboxDrive",
        "DataPowerTrain2"
      ],
      "de.bmw.infotainment.KombiIF": [
        "statusRangeTankStatus"
      ],
      "de.bmw.infrastructure.EnvironmentalInformation": [
        "ExteriorTemperature"
      ]
    }
  }
}
