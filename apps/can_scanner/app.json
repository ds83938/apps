{
  "id": "can_scanner",
  "title": "Signal Scanner",
  "description": "Logs every change of the car signals it listens to, with a time, to a file, and after a Mark says which quiet signals moved. Read only.",
  "version": "0.3.0",
  "vendor": "custom",
  "loggingId": "SCAN",
  "iconGlyph": "SCN",
  "shared": [],
  "signals": {
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineSpeed2": "rs",
      "statusEngineTemperature": "rs"
    },
    "de.bmw.infotainment.vehicle.CDS2": {
      "statusLongitudinalAccelerationMassCenter": "rs",
      "statusLateralAccelerationMassCenter": "rs"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infotainment.drivingexcitement.FES": "*",
    "de.bmw.infrastructure.VehicleInformation": "*",
    "de.bmw.infotainment.KombiIF": {
      "statusRangeTankStatus": "rs"
    },
    "de.bmw.infrastructure.EnvironmentalInformation": {
      "ExteriorTemperature": "s"
    },
    "de.bmw.infotainment.vehicle.TPMS": {
      "statusTyrePressure": "rs",
      "statusTyreTemperature": "rs",
      "_optional": "tyre pressures in the scan"
    },
    "de.bmw.infotainment.misc.MDrive": {
      "dataDisplayGearbox": "s",
      "_optional": "the M drive display in the scan"
    },
    "de.bmw.infrastructure.VehicleCondition": {
      "VehicleCondition": "s",
      "_optional": "the car's wake / ignition state in the scan"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "menu",
      "title": "Signal Scanner",
      "items": [
        [
          "button",
          "BTN_MARK",
          "Mark (then press the button you're testing)"
        ],
        [
          "button",
          "BTN_NEW",
          "New log"
        ],
        [
          "text",
          "STATUS",
          ""
        ],
        [
          "text",
          "FILE",
          ""
        ],
        [
          "text3",
          "MARKED",
          ""
        ],
        [
          "scroll",
          "RECENT",
          ""
        ],
        [
          "scroll",
          "FOUND",
          ""
        ]
      ]
    }
  ],
  "settings": [],
  "config": {
    "_comment": "watch: what the scanner subscribes to, interface -> fields, or \"*\" for every field the interface has. Keep it in step with \"signals\" (the installer only grants what \"signals\" lists; the build does not pass \"signals\" to the app). poll: also re-read that interface's fields every N ms (the car never notifies tyre pressures). quietInMark: always counted as busy in a Mark result. search: catalogue names to list on the page.",
    "watch": {
      "de.bmw.infotainment.vehicle.CDS": [
        "statusEngineSpeed2",
        "statusEngineTemperature"
      ],
      "de.bmw.infotainment.vehicle.CDS2": [
        "statusLongitudinalAccelerationMassCenter",
        "statusLateralAccelerationMassCenter"
      ],
      "de.bmw.infotainment.vehicle.Vehicle2": [
        "statusCarSpeed2"
      ],
      "de.bmw.infotainment.drivingexcitement.FES": "*",
      "de.bmw.infrastructure.VehicleInformation": "*",
      "de.bmw.infotainment.KombiIF": [
        "statusRangeTankStatus"
      ],
      "de.bmw.infrastructure.EnvironmentalInformation": [
        "ExteriorTemperature"
      ],
      "de.bmw.infotainment.vehicle.TPMS": [
        "statusTyrePressure",
        "statusTyreTemperature"
      ],
      "de.bmw.infotainment.misc.MDrive": [
        "dataDisplayGearbox"
      ],
      "de.bmw.infrastructure.VehicleCondition": [
        "VehicleCondition"
      ]
    },
    "quietInMark": [
      "CDS2.statusLongitudinalAccelerationMassCenter",
      "CDS2.statusLateralAccelerationMassCenter"
    ],
    "search": "exhaust|abgas|klappe|flap|auspuff|sound|akust|acoust",
    "poll": {
      "de.bmw.infotainment.vehicle.TPMS": 4000
    }
  }
}
